/* ============================================================
   Pharmacy Management System — Clean Light Theme
   ============================================================ */

/* ---------- Global ---------- */
QWidget {
    background-color: #f1f5f9;
    color: #0f172a;
    font-family: "Segoe UI", sans-serif;
    font-size: 10pt;
}

QMainWindow { background-color: #f1f5f9; }

/* ---------- Scrollbars ---------- */
QScrollBar:vertical { background: transparent; width: 8px; border-radius: 4px; margin: 2px; }
QScrollBar::handle:vertical { background: #cbd5e1; min-height: 30px; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 8px; border-radius: 4px; margin: 2px; }
QScrollBar::handle:horizontal { background: #cbd5e1; min-width: 30px; border-radius: 4px; }
QScrollBar::handle:horizontal:hover { background: #94a3b8; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

/* ---------- Sidebar ---------- */
#Sidebar { background-color: #f8fafc; border-right: 1px solid #e2e8f0; }
#Sidebar QPushButton { background-color: transparent; color: #64748b; border: none; border-radius: 8px; padding: 10px 16px; text-align: left; font-size: 10pt; margin: 2px 8px; qproperty-iconSize: 18px 18px; }
#Sidebar QPushButton:hover { background-color: #ffffff; color: #0f172a; }
#Sidebar QPushButton:pressed { background-color: #e2e8f0; color: #0f172a; }
#Sidebar QPushButton:checked, #Sidebar QPushButton[active="true"] { background-color: #2563eb; color: #ffffff; font-weight: bold; }
#Sidebar QPushButton:checked:hover, #Sidebar QPushButton[active="true"]:hover { background-color: #3b82f6; }
#Sidebar QPushButton:checked:pressed, #Sidebar QPushButton[active="true"]:pressed { background-color: #1d4ed8; }

/* ---------- Header ---------- */
#Header { background-color: #ffffff; border-bottom: 1px solid #e2e8f0; padding: 8px 20px; }
#HeaderTitle { color: #0f172a; font-size: 14pt; font-weight: bold; }
#HeaderText { color: #64748b; font-size: 9pt; }

/* ---------- Content Area ---------- */
#ContentArea { background-color: #f1f5f9; border: none; }

/* ---------- Pages ---------- */
#PageTitle { color: #2563eb; font-size: 22pt; font-weight: bold; }
#PageDescription { color: #64748b; font-size: 11pt; }

/* ---------- Welcome Page ---------- */
#WelcomeTitle { color: #2563eb; font-size: 26pt; font-weight: bold; }
#WelcomeSubtitle { color: #0f172a; font-size: 13pt; }
#WelcomeBody { color: #64748b; font-size: 11pt; }

/* ---------- Toolbar Buttons ---------- */
#ToolbarButton { background-color: #ffffff; color: #0f172a; border: 1px solid #d1d5db; border-radius: 6px; padding: 8px 16px; font-size: 10pt; }
#ToolbarButton:hover { background-color: #f1f5f9; border-color: #94a3b8; }
#ToolbarButton:pressed { background-color: #e2e8f0; }

/* ---------- Primary Button ---------- */
#PrimaryButton { background-color: #2563eb; color: #ffffff; border: none; border-radius: 6px; padding: 8px 24px; font-weight: bold; font-size: 10pt; }
#PrimaryButton:hover { background-color: #3b82f6; }
#PrimaryButton:pressed { background-color: #1d4ed8; }

/* ---------- Search Box ---------- */
#SearchBox { background-color: #ffffff; color: #0f172a; border: 1px solid #d1d5db; border-radius: 6px; padding: 8px 14px; font-size: 10pt; }
#SearchBox:focus { border-color: #2563eb; }
#SearchBox::placeholder { color: #94a3b8; }

/* ---------- Tables (Global) ---------- */
QTableWidget { background-color: #ffffff; alternate-background-color: #f8fafc; color: #0f172a; border: 1px solid #e2e8f0; border-radius: 8px; gridline-color: transparent; selection-background-color: #dbeafe; selection-color: #0f172a; font-size: 10pt; outline: none; }
QTableWidget::item { padding: 10px 14px; border: none; border-bottom: 1px solid #f1f5f9; }
QTableWidget::item:selected { background-color: #dbeafe; }
QTableWidget::item:hover { background-color: #f1f5f9; }
QHeaderView::section { background-color: #f8fafc; color: #64748b; border: none; border-bottom: 2px solid #e2e8f0; border-right: 1px solid #f1f5f9; padding: 10px 14px; font-weight: bold; font-size: 9pt; text-transform: uppercase; letter-spacing: 0.5px; }
QHeaderView::section:hover { background-color: #f1f5f9; color: #0f172a; }
QTableCornerButton::section { background-color: #f8fafc; border: none; border-bottom: 2px solid #e2e8f0; border-right: 1px solid #f1f5f9; }

/* ---------- Inline Action Buttons (per-row) ---------- */
#ActionEditBtn, #ActionDeleteBtn {
    border: none;
    border-radius: 4px;
    padding: 4px 6px;
    font-size: 10pt;
    min-width: 28px;
    max-width: 28px;
    min-height: 24px;
    max-height: 24px;
}
#ActionEditBtn {
    color: #2563eb;
    background-color: transparent;
}
#ActionEditBtn:hover {
    background-color: #dbeafe;
}
#ActionEditBtn:pressed {
    background-color: #bfdbfe;
}
#ActionDeleteBtn {
    color: #dc2626;
    background-color: transparent;
}
#ActionDeleteBtn:hover {
    background-color: #fee2e2;
}
#ActionDeleteBtn:pressed {
    background-color: #fecaca;
}

/* ---------- Empty State ---------- */
#EmptyState { color: #94a3b8; font-size: 14pt; padding: 40px; }

/* ---------- Section Title ---------- */
#SectionTitle { color: #0f172a; font-size: 12pt; font-weight: bold; }
#StockLabel { color: #64748b; font-size: 10pt; }

/* ---------- Dashboard Cards ---------- */
#DashboardCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}
#DashboardCard:hover {
    border-color: #cbd5e1;
}

/* ---------- Medicine Card (POS) ---------- */
#MedicineCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}
#MedicineCard:hover {
    border-color: #2563eb;
}

/* ---------- Status Bar ---------- */
QStatusBar { background-color: #ffffff; color: #64748b; border-top: 1px solid #e2e8f0; font-size: 9pt; padding: 2px 10px; }
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #64748b; padding: 0 8px; }

/* ---------- Dialog ---------- */
QDialog { background-color: #f1f5f9; }
QDialog QLabel { color: #0f172a; }
QLineEdit, QSpinBox, QComboBox { background-color: #ffffff; color: #0f172a; border: 1px solid #d1d5db; border-radius: 6px; padding: 8px 12px; font-size: 10pt; }
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #2563eb; }
QSpinBox::up-button, QSpinBox::down-button { background-color: #e2e8f0; border: none; width: 20px; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background-color: #cbd5e1; }
QDoubleSpinBox { background-color: #ffffff; color: #0f172a; border: 1px solid #d1d5db; border-radius: 6px; padding: 8px 12px; font-size: 10pt; }
QDoubleSpinBox:focus { border-color: #2563eb; }
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { background-color: #e2e8f0; border: none; width: 20px; }
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background-color: #cbd5e1; }
QComboBox { background-color: #ffffff; color: #0f172a; border: 1px solid #d1d5db; border-radius: 6px; padding: 8px 12px; font-size: 10pt; }
QComboBox:focus { border-color: #2563eb; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow { image: none; border-left: 5px solid transparent; border-right: 5px solid transparent; border-top: 6px solid #64748b; margin-right: 8px; }
QComboBox QAbstractItemView { background-color: #ffffff; color: #0f172a; border: 1px solid #d1d5db; selection-background-color: #dbeafe; selection-color: #0f172a; padding: 4px; }
QDateEdit { background-color: #ffffff; color: #0f172a; border: 1px solid #d1d5db; border-radius: 6px; padding: 8px 12px; font-size: 10pt; }
QDateEdit:focus { border-color: #2563eb; }
QDateEdit::drop-down { border: none; width: 24px; }
QCheckBox { color: #0f172a; spacing: 8px; font-size: 10pt; }
QCheckBox::indicator { width: 16px; height: 16px; border-radius: 3px; border: 1px solid #d1d5db; background-color: #ffffff; }
QCheckBox::indicator:checked { background-color: #2563eb; border-color: #2563eb; }
QCheckBox::indicator:hover { border-color: #3b82f6; }
QCalendarWidget { background-color: #ffffff; color: #0f172a; }
QCalendarWidget QToolButton { background-color: #f1f5f9; color: #0f172a; border: 1px solid #d1d5db; border-radius: 4px; padding: 4px 8px; }
QCalendarWidget QToolButton:hover { background-color: #e2e8f0; }
QCalendarWidget QToolButton#qt_calendar_prevmonth, QCalendarWidget QToolButton#qt_calendar_nextmonth { qproperty-icon: none; min-width: 24px; }

/* ---------- Tooltip ---------- */
QToolTip { background-color: #ffffff; color: #0f172a; border: 1px solid #d1d5db; border-radius: 4px; padding: 4px 8px; }

/* ---------- MessageBox ---------- */
QMessageBox { background-color: #f1f5f9; }
QMessageBox QPushButton { background-color: #ffffff; color: #0f172a; border: 1px solid #d1d5db; border-radius: 6px; padding: 6px 18px; min-width: 80px; }
QMessageBox QPushButton:hover { background-color: #f1f5f9; }
QMessageBox QPushButton#qt_msgbox_yes_button, QMessageBox QPushButton#qt_msgbox_ok_button { background-color: #2563eb; color: #ffffff; border: none; }
QMessageBox QPushButton#qt_msgbox_yes_button:hover, QMessageBox QPushButton#qt_msgbox_ok_button:hover { background-color: #3b82f6; }

/* ---------- OCR Drop Zone ---------- */
#OCDDropZone { border: 2px dashed #d1d5db; border-radius: 8px; background-color: #f8fafc; }
#OCDDropZone:hover { border-color: #2563eb; }

/* ---------- AI Results Frame ---------- */
#AIResultsFrame { background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; }

/* ---------- AI Analyze Button ---------- */
#AIAnalyzeButton { background-color: #7c3aed; color: #ffffff; border: none; border-radius: 6px; padding: 8px 20px; font-weight: bold; font-size: 10pt; }
#AIAnalyzeButton:hover { background-color: #8b5cf6; }
#AIAnalyzeButton:pressed { background-color: #6d28d9; }

/* ---------- AI Items Table ---------- */
#AIItemsTable { background-color: #ffffff; alternate-background-color: #f8fafc; color: #0f172a; border: 1px solid #e2e8f0; border-radius: 6px; gridline-color: transparent; selection-background-color: #dbeafe; font-size: 10pt; outline: none; }
#AIItemsTable::item { padding: 8px 10px; border-bottom: 1px solid #f1f5f9; }
#AIItemsTable::item:selected { background-color: #dbeafe; }
#AIItemsTable::item:hover { background-color: #f1f5f9; }

/* ---------- Settings Nav ---------- */
#SettingsNavBtn { background-color: transparent; color: #64748b; border: none; border-radius: 6px; padding: 8px 16px; text-align: left; font-size: 10pt; }
#SettingsNavBtn:hover { background-color: #ffffff; color: #0f172a; }
#SettingsNavBtn:checked { background-color: #dbeafe; color: #0f172a; font-weight: bold; }

/* ---------- Settings Section Header ---------- */
#SettingsSectionHeader { color: #2563eb; font-size: 13pt; font-weight: bold; padding: 4px 0; }

/* ---------- Settings Content ---------- */
#SettingsContent { background-color: transparent; border: none; }

/* ---------- Splitter ---------- */
QSplitter::handle { background-color: #e2e8f0; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }
QSplitter::handle:hover { background-color: #2563eb; }

/* ---------- Form Layout ---------- */
QFormLayout QLabel { color: #64748b; font-size: 10pt; }

/* ---------- GroupBox ---------- */
QGroupBox { border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 12px; padding-top: 16px; font-weight: bold; color: #0f172a; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; }
